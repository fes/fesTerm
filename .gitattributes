*.sh text eol=lf

# Bundled font assets are pinned by sha256 in per-family manifests. Prevent
# Windows autocrlf conversion from changing checksummed licenses/build plans,
# and make the binary treatment of font files explicit.
assets/fonts/**/*.txt text eol=lf
assets/fonts/**/*.md text eol=lf
assets/fonts/**/*.toml text eol=lf
assets/fonts/*/LICENSE text eol=lf
# JuliaMono's upstream release archive ships its LICENSE with CRLF line
# endings; the checked-in copy and its sha256 pin in manifest.json preserve
# those upstream bytes exactly, so exempt it from eol normalization (later
# patterns override earlier ones for the same path).
assets/fonts/julia-mono/LICENSE -text
assets/fonts/**/*.ttf binary
assets/fonts/noto-emoji/OFL.txt whitespace=-blank-at-eol
tests/fixtures/unicode/**/*.txt text eol=lf whitespace=-blank-at-eol
crates/*/tests/fixtures/unicode/**/*.txt text eol=lf whitespace=-blank-at-eol

# Pseudoterminal captures are byte-for-byte evidence: the replay tests assert
# on exact cell contents, and the recordings contain bare CR and LF bytes as
# part of the escape sequences themselves. Line-ending normalization on a
# Windows checkout would silently rewrite them into something no program ever
# emitted, so they are binary regardless of what git's heuristics decide.
crates/*/tests/fixtures/**/*.raw binary
