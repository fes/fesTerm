*.sh text eol=lf
scripts/install-dev-tunnel.ps1 text eol=lf

# Bundled font assets are pinned by sha256 in per-family manifests. Prevent
# Windows autocrlf conversion from changing checksummed licenses/build plans,
# and make the binary treatment of font files explicit.
assets/fonts/**/*.txt text eol=lf
assets/fonts/**/*.md text eol=lf
assets/fonts/**/*.toml text eol=lf
assets/fonts/*/LICENSE text eol=lf
# JuliaMono's upstream release archive ships its LICENSE with CRLF line
# endings; the checked-in copy and its sha256 pin in manifest.json preserve
# those upstream bytes exactly, so exempt it from eol normalization (later
# patterns override earlier ones for the same path).
assets/fonts/julia-mono/LICENSE -text
assets/fonts/**/*.ttf binary
assets/fonts/noto-emoji/OFL.txt whitespace=-blank-at-eol
tests/fixtures/unicode/**/*.txt text eol=lf whitespace=-blank-at-eol
crates/*/tests/fixtures/unicode/**/*.txt text eol=lf whitespace=-blank-at-eol

# Pseudoterminal captures are byte-for-byte evidence: the replay tests assert
# on exact cell contents, and the recordings contain bare CR and LF bytes as
# part of the escape sequences themselves. Line-ending normalization on a
# Windows checkout would silently rewrite them into something no program ever
# emitted, so they are binary regardless of what git's heuristics decide.
crates/*/tests/fixtures/**/*.raw binary

# Preserve original native probe JSON bytes, including transport-added final LF.
validation/dev-tunnels/linux-client-mac-native-off/*-capabilities.json -text whitespace=-blank-at-eof
validation/dev-tunnels/mac-client-linux-native-on/*-capabilities.json -text

# Preserve original native OFF-case capability reports on every checkout.
validation/dev-tunnels/mac-client-linux-native-off/*-capabilities.json -text

# Preserve native lifecycle diagnostics and SDK result bytes.
validation/dev-tunnels/linux-owner-first-result-0.17.19/*.json -text

# Preserve original rooted Files native proof and uploaded public payload bytes.
validation/dev-tunnels/linux-files-native-readwrite/*.json -text
validation/dev-tunnels/linux-files-native-readwrite/r36payload.md -text

# Preserve original finite native post-manager observation evidence.
validation/dev-tunnels/linux-owner-after-manager-busy/*.json -text

# Preserve original reviewed Files deletion diagnostics and proof bytes.
validation/dev-tunnels/linux-files-native-reviewed-delete/*.json -text

# Preserve original successful native first-completion proof bytes.
validation/dev-tunnels/linux-owner-post-manager-first-result-0.17.19/*.json -text
validation/dev-tunnels/linux-owner-post-manager-first-result-0.17.19/*.jsonl -text

# Preserve ninth-case native query and SDK result bytes.
validation/dev-tunnels/linux-client-mac-native-on/*-capabilities.json -text whitespace=-blank-at-eof
validation/dev-tunnels/linux-client-mac-native-on/sdk-native-result.log -text whitespace=-blank-at-eof

# Preserve byte-original native20 component proof.
validation/dev-tunnels/mac-owner-stopped-update-0.17.20/*.json -text
validation/dev-tunnels/windows-client-privacy-0.17.20/*.json -text
validation/dev-tunnels/ios-saved-account-reopen-0.17.20/*.json -text
validation/dev-tunnels/mac-owner-stopped-update-0.17.20/*.jsonl -text
